{
  "project": {
    "name": "toy-sleep-experiment",
    "description": "CPU-only demo profile for Experiment Control Agent.",
    "control_root": "."
  },
  "codex": {
    "home": ".codex-home",
    "auth_required": false,
    "conda_init": "",
    "conda_env": "",
    "extra_path_entries": [],
    "default_model": "",
    "default_reasoning_effort": "",
    "fallback_after_failures": 3,
    "fallback_model": "",
    "fallback_reasoning_effort": "",
    "secondary_fallback_after_failures": 5,
    "secondary_fallback_model": "",
    "secondary_fallback_reasoning_effort": "",
    "disable_response_storage": true
  },
  "supervisor": {
    "session_name": "experiment-control-agent",
    "check_interval_seconds": 10,
    "heartbeat_seconds": 60,
    "min_cycle_gap_seconds": 30,
    "cycle_timeout_seconds": 300,
    "retry_base_seconds": 10,
    "retry_max_seconds": 60
  },
  "modes": {
    "agent_modes": ["method_exploration", "audit_validation", "target_recovery"],
    "default_agent_mode": "method_exploration",
    "agent_mode_contracts": {
      "method_exploration": {
        "purpose": "Demonstrate early-stage exploration with tiny CPU-only candidate tasks.",
        "entry_conditions": [
          "the user is learning the control plane",
          "toy task behavior or result signatures need a safe small-scale demonstration"
        ],
        "required_reads": [
          "examples/toy-sleep-experiment/profile/CYCLE_BRIEF.md",
          "runtime/current_status.md",
          "runtime/research_lanes.md",
          "active toy jobs"
        ],
        "allowed_actions": [
          "propose a tiny toy hypothesis",
          "run the toy batch script",
          "inspect completed.json files",
          "update toy status and journal files"
        ],
        "required_artifacts": [
          "toy research question and hypothesis",
          "toy validation design",
          "completed.json files from toy tasks",
          "runtime/current_status.md",
          "runtime/research_lanes.md"
        ],
        "success_criteria": [
          "a tiny candidate behavior is tested with evidence",
          "result signature changes after completion",
          "status files identify the generated outputs"
        ],
        "escalation_criteria": [
          "toy task script fails before writing completed.json",
          "job detection or result watch paths do not match the toy project"
        ]
      },
      "audit_validation": {
        "purpose": "Validate that toy job detection and completion artifacts are wired correctly.",
        "entry_conditions": [
          "toy processes are not detected as expected",
          "completed.json files are missing or malformed",
          "result signatures do not change after toy completion"
        ],
        "required_reads": [
          "examples/toy-sleep-experiment/profile/CYCLE_BRIEF.md",
          "runtime/current_status.md",
          "runtime/research_lanes.md",
          "active toy jobs",
          "toy completed.json files if present"
        ],
        "allowed_actions": [
          "inspect toy process detection",
          "inspect completed.json files",
          "rerun bounded toy tasks if needed",
          "update toy status and journal files"
        ],
        "required_artifacts": [
          "uncertainty being validated",
          "toy evidence path",
          "verdict",
          "promotion or follow-up criterion"
        ],
        "success_criteria": [
          "one toy wiring uncertainty is resolved",
          "the next safe action is clear"
        ],
        "escalation_criteria": [
          "the toy task script fails before writing completed.json",
          "the configured paths cannot be reconciled with generated outputs"
        ]
      },
      "target_recovery": {
        "purpose": "Demonstrate a target-oriented mode using toy completion targets.",
        "entry_conditions": [
          "the user wants all toy tasks completed",
          "completion files are the target evidence"
        ],
        "required_reads": [
          "examples/toy-sleep-experiment/profile/TARGETS.md",
          "runtime/current_status.md",
          "runtime/research_lanes.md"
        ],
        "allowed_actions": [
          "launch missing toy tasks",
          "inspect completed.json files",
          "mark toy targets completed"
        ],
        "required_artifacts": [
          "one completed.json per toy target",
          "updated runtime/current_status.md",
          "updated runtime/research_lanes.md"
        ],
        "success_criteria": [
          "each toy target has a completion artifact",
          "the status file points to the result directory"
        ],
        "escalation_criteria": [
          "toy target names or expected outputs are ambiguous"
        ]
      }
    },
    "execution_modes": ["event", "interval", "batch_low_api", "manual"],
    "default_execution_mode": "manual",
    "batch_profiles": {
      "auto": {
        "target_min_hours": 0,
        "target_max_hours": 1,
        "min_gpu_packages": 0,
        "force_fill_idle_gpus": 0,
        "max_codex_turns": 1
      }
    },
    "default_batch_profile": "auto"
  },
  "workspaces": {
    "toy": {
      "path": "examples/toy-sleep-experiment",
      "writable": true
    }
  },
  "originals": {},
  "job_detection": {
    "managed_hints": ["{root}", "toy-sleep-experiment"],
    "patterns": [
      {
        "category": "toy_task",
        "regex": "examples/toy-sleep-experiment/toy_task\\.py"
      },
      {
        "category": "batch_wrapper",
        "regex": "runtime/batch_low_api/batches/.*/run_.*\\.sh"
      }
    ],
    "exclude_patterns": [
      "\\bcodex exec\\b",
      "\\blist_active_jobs\\.py\\b",
      "\\bvalidate_agent_state\\.py\\b"
    ]
  },
  "results": {
    "watch_paths": ["runtime", "examples/toy-sleep-experiment/results"],
    "file_patterns": ["completed.json", "metrics_summary.json", "*aggregate*.json"],
    "include_tmux_sessions": false,
    "include_gpu_compute_apps": false
  },
  "batch": {
    "manifest_columns": ["id", "lane", "target", "resources", "output_root", "log_path", "decision_after_completion"],
    "supplemental": {
      "enabled": false,
      "min_active_seconds": 60,
      "min_cycle_gap_seconds": 60,
      "result_change_gap_seconds": 30,
      "min_idle_gpus": 0,
      "idle_gpu_memory_max_mb": 1000,
      "idle_gpu_util_max": 10
    }
  },
  "project_docs": {
    "cycle_brief": "examples/toy-sleep-experiment/profile/CYCLE_BRIEF.md",
    "agents_policy": "examples/toy-sleep-experiment/profile/AGENTS.project.md",
    "reference_docs": ["examples/toy-sleep-experiment/profile/TARGETS.md"]
  }
}
